{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imfde",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // 雷达每小时抓取；种子拟真互动由 */5 驱动，内部 D1 随机门控（5 分钟～4 小时）。
  "triggers": { "crons": ["0 * * * *", "*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Video needs byte-range responses (206) for Safari/iOS; every other
    // static asset still serves directly from the CDN.
    "run_worker_first": ["/videos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imfde",
      "database_id": "99b2f49c-366f-499a-a742-a3e2cc9248bd",
      "migrations_dir": "migrations"
    }
  ],
  // www.imfde.ai is served by a zone Workers route + proxied CNAME, so it is
  // intentionally not listed here; binding it as a custom domain would clash
  // with that existing record.
  "routes": [{ "pattern": "imfde.ai", "custom_domain": true }]
}
