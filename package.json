{
  "name": "imfde",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply imfde --local",
    "db:migrate:remote": "wrangler d1 migrations apply imfde --remote",
    "db:seed:local": "wrangler d1 execute imfde --local --file=scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute imfde --remote --file=scripts/seed.sql",
    "db:unseed:local": "wrangler d1 execute imfde --local --file=scripts/unseed.sql",
    "db:unseed:remote": "wrangler d1 execute imfde --remote --file=scripts/unseed.sql"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "isbot": "^5.1.17",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "react-use-measure": "^2.1.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@react-router/dev": "^7.9.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.42.0"
  }
}
